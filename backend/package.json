{
  "name": "taskflow-api",
  "version": "1.0.0",
  "description": "TaskFlow REST API: teams, boards, columns, cards with JWT auth",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx src/seed.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "type": "module",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@prisma/client": "^7.10.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.4",
    "@types/supertest": "^7.2.1",
    "prisma": "^8.0.0-rc.19",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "private": true
}